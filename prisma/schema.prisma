generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole { ADMIN TECNICO }
enum WorkOrderType { GENERAL AVERIA MANTENIMIENTO VISITA_PRESUPUESTO }
enum WorkOrderStatus { PENDIENTE EN_CURSO TERMINADO }
enum FinancialMovementKind { PAGO FINANCIACION }
enum PaymentMethod { EFECTIVO TRANSFERENCIA MERCADO_PAGO }
enum BudgetStatus { BORRADOR }

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role UserRole @default(TECNICO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  assignedWorkOrders WorkOrder[] @relation("AssignedTechnician")
  createdWorkOrders WorkOrder[] @relation("CreatedBy")
  createdMovements FinancialMovement[]
}

model Session { id String @id; expiresAt DateTime; token String @unique; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; ipAddress String?; userAgent String?; userId String; user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model Account { id String @id; accountId String; providerId String; userId String; accessToken String?; refreshToken String?; idToken String?; accessTokenExpiresAt DateTime?; refreshTokenExpiresAt DateTime?; scope String?; password String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model Verification { id String @id; identifier String; value String; expiresAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }

model Client { id String @id @default(cuid()); name String; phone String; email String?; address String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; workOrders WorkOrder[]; @@index([name]); @@index([phone]) }
model WorkOrder { id String @id @default(cuid()); clientId String; assignedTechnicianId String?; createdById String; type WorkOrderType; status WorkOrderStatus @default(PENDIENTE); workDate DateTime; startedAt DateTime?; durationMinutes Int?; description String; totalCents Int @default(0); closedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; client Client @relation(fields:[clientId], references:[id]); assignedTechnician User? @relation("AssignedTechnician", fields:[assignedTechnicianId], references:[id]); createdBy User @relation("CreatedBy", fields:[createdById], references:[id]); materials Material[]; recordedMovements FinancialMovement[] @relation("RecordedOn"); appliedMovements FinancialMovement[] @relation("AppliedTo"); budgets Budget[] }
model Material { id String @id @default(cuid()); workOrderId String; name String; quantity Int; createdAt DateTime @default(now()); workOrder WorkOrder @relation(fields:[workOrderId], references:[id], onDelete:Cascade) }
model FinancialMovement { id String @id @default(cuid()); recordedOnWorkOrderId String; appliedToWorkOrderId String; kind FinancialMovementKind; amountCents Int; paymentMethod PaymentMethod?; installmentCount Int?; createdById String; createdAt DateTime @default(now()); recordedOnWorkOrder WorkOrder @relation("RecordedOn", fields:[recordedOnWorkOrderId], references:[id]); appliedToWorkOrder WorkOrder @relation("AppliedTo", fields:[appliedToWorkOrderId], references:[id]); createdBy User @relation(fields:[createdById], references:[id]) }
model Budget { id String @id @default(cuid()); workOrderId String; status BudgetStatus @default(BORRADOR); totalCents Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; workOrder WorkOrder @relation(fields:[workOrderId], references:[id]); lines BudgetLine[] }
model BudgetLine { id String @id @default(cuid()); budgetId String; concept String; quantity Int; unitPriceCents Int; budget Budget @relation(fields:[budgetId], references:[id], onDelete:Cascade) }
